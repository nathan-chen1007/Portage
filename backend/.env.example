# Copy this file to .env and fill in your keys. Never commit .env.

# LLM: any OpenAI-compatible provider. Defaults to DeepSeek.
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
# Your cloned voice's ID (falls back to the stock "George" voice if unset)
# ELEVENLABS_VOICE_ID=

# Frontend origins allowed to call the API (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Port for the API (default 8000). Change it if Windows refuses 8000 with WinError 10013.
# API_PORT=8000
